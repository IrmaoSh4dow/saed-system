# SAED API - copy to api/.env
# Railway API Public Networking uses port 8081 (frontend uses 8080).

NODE_ENV=development
PORT=8081
API_PREFIX=api/v1

# Public frontend origin(s) for CORS (comma-separated). With or without https://
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://saed:saed@localhost:5432/saed?schema=public

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:8081/api/v1/auth/discord/callback
