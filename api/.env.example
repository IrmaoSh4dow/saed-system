# SAED API - copy to api/.env
# On Railway, PORT is injected by the platform (do not hardcode 8081).

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Public frontend origin(s) for CORS (comma-separated). With or without https://
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://saed:saed@localhost:5432/saed?schema=public

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional: Discord webhook for duty clock events (never expose to frontend)
DISCORD_SHIFTS_WEBHOOK_URL=

# Optional: public origin used when building absolute asset URLs
PUBLIC_ASSET_BASE_URL=http://localhost:5173
DISCORD_INCENTIVES_WEBHOOK_URL=
DISCORD_NEWS_WEBHOOK_URL=
DISCORD_APPLICATIONS_WEBHOOK_URL=
