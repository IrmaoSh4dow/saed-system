generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  DISCORD
}

enum AccountStatus {
  ACTIVE
  DISABLED
  BANNED
}

enum CharacterStatus {
  CIVIL
  INTERN
  MEDICAL_STAFF
  RETIRED
  SUSPENDED
}

enum CharacterSex {
  MALE
  FEMALE
  OTHER
}

/// Clinical blood type for Patient records (not Character auth identity).
enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
  ARCHIVED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  RETIRED
}

enum OccupationType {
  DEPARTMENT
  BUSINESS
  EMPLOYMENT
  OTHER
}

enum ComplaintStatus {
  PENDING
  UNDER_INVESTIGATION
  WAITING_FOR_CITIZEN
  RESOLVED
  REJECTED
  CLOSED
}

enum ComplaintEvidenceType {
  IMAGE
  VIDEO_URL
}

enum ComplaintEventType {
  CREATED
  STATUS_CHANGED
  INVESTIGATOR_ASSIGNED
  INVESTIGATOR_REMOVED
  MESSAGE_SENT
  INTERNAL_NOTE_ADDED
  EVIDENCE_ADDED
  EVIDENCE_REMOVED
}

enum AppointmentType {
  MEDICAL
  PSYCHOTECHNICAL_CIVIL
  PSYCHOTECHNICAL_LSPD
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  WAITING_FOR_CITIZEN
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

enum AppointmentEventType {
  CREATED
  STATUS_CHANGED
  STAFF_ASSIGNED
  STAFF_REMOVED
  DEPARTMENT_TRANSFERRED
  MESSAGE_SENT
  INTERNAL_NOTE_ADDED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum GalleryItemStatus {
  ACTIVE
  HIDDEN
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum NotificationType {
  COMPLAINT_CREATED
  COMPLAINT_MESSAGE
  COMPLAINT_STATUS
  COMPLAINT_ASSIGNED
  APPOINTMENT_CREATED
  APPOINTMENT_MESSAGE
  APPOINTMENT_STATUS
  APPOINTMENT_ASSIGNED
  ADMIN_REQUEST_CREATED
  ADMIN_REQUEST_MESSAGE
  ADMIN_REQUEST_STATUS
  ADMIN_REQUEST_ASSIGNED
  ADMIN_REQUEST_NOTE
  MEDICAL_RECORD_ACCESS_CREATED
  MEDICAL_RECORD_ACCESS_STATUS
  MEDICAL_REPORT_ACCESS_GRANTED
  MEDICAL_REPORT_ACCESS_REVOKED
  MEDICAL_REPORT_ACCESS_EXPIRING
  STAFF_RATING_CREATED
  DEPARTMENT_OPENING
  DEPARTMENT_INTEREST_LETTER
  DEPARTMENT_APPLICATION_ACCEPTED
  DEPARTMENT_APPLICATION_REJECTED
  DEPARTMENT_ASSIGNED
  REPORT_CREATED
  REPORT_ASSIGNED
  REPORT_STATUS
  REPORT_TRANSFERRED
  REPORT_EVIDENCE
  REPORT_PARTICIPANT
  ACADEMY_APPLICATION_SUBMITTED
  ACADEMY_APPLICATION_ACCEPTED
  ACADEMY_APPLICATION_REJECTED
  ACADEMY_TRAINING_CREATED
  ACADEMY_ANNOUNCEMENT
  ACADEMY_ATTENDANCE
  SYSTEM
}

/// Extensible catalog of institutional administrative request kinds.
enum AdminRequestType {
  ADMINISTRATIVE_APPOINTMENT
  AGREEMENT_SIGNING
  HIGH_COMMAND_MEETING
  COMMERCIAL_REQUEST
  OTHER
}

enum AdminRequestStatus {
  PENDING
  UNDER_REVIEW
  IN_PROCESS
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum AdminRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AdminRequestEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  MESSAGE_SENT
  INTERNAL_NOTE_ADDED
  PRIORITY_CHANGED
}

enum AcademyTrainingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AcademyAttendanceStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum AcademyAnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AcademyApplicationType {
  ACADEMY
  TRANSFER
}

enum AcademyApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// Persistent intake switch per application type (Academia, Traslado, …).
model ApplicationConfiguration {
  id                  String                 @id @default(uuid())
  type                AcademyApplicationType @unique
  isOpen              Boolean                @default(false)
  openedByCharacterId String?
  openedByCharacter   Character?             @relation("ApplicationConfigOpenedBy", fields: [openedByCharacterId], references: [id], onDelete: SetNull)
  closedByCharacterId String?
  closedByCharacter   Character?             @relation("ApplicationConfigClosedBy", fields: [closedByCharacterId], references: [id], onDelete: SetNull)
  openedAt            DateTime?
  closedAt            DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([isOpen])
}

enum DepartmentOpeningStatus {
  OPEN
  CLOSED
  COMPLETED
}

enum DepartmentMembershipRole {
  MEMBER
  LEAD
  SUPERVISOR
}

enum InterestLetterStatus {
  PENDING
  ACCEPTED
  REJECTED
  NEEDS_INFO
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  ARCHIVED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportType {
  CONSULTATION
  DIAGNOSTIC
  PROCEDURE
  HOSPITALIZATION
  INTERNAL
  OTHER
}

enum ReportEvidenceType {
  IMAGE
  VIDEO_URL
  DOCUMENT
}

model Account {
  id                String         @id @default(uuid())
  email             String?        @unique
  username          String         @unique
  displayName       String?
  status            AccountStatus  @default(ACTIVE)
  activeCharacterId String?        @unique
  activeCharacter   Character?     @relation("ActiveCharacter", fields: [activeCharacterId], references: [id], onDelete: SetNull)
  identities        AuthIdentity[]
  characters        Character[]    @relation("AccountCharacters")
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]     @relation("AuditActorAccount")
  notifications     Notification[]
  licensesAssigned  StaffLicense[] @relation("LicenseAssignedBy")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model AuthIdentity {
  id                String       @id @default(uuid())
  accountId         String
  account           Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String
  passwordHash      String?
  profile           Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([provider, providerAccountId])
  @@index([accountId])
}

model RefreshToken {
  id           String    @id @default(uuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([accountId])
  @@index([expiresAt])
}

/// Identity inside the RP world. May be civilian or SAED-affiliated.
model Character {
  id             String          @id @default(uuid())
  accountId      String
  account        Account         @relation("AccountCharacters", fields: [accountId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  birthDate      DateTime?       @db.Date
  sex            CharacterSex?
  nationality    String?
  phone          String?
  biography      String?
  avatarUrl      String?
  status         CharacterStatus @default(CIVIL)
  /// Optional civilian/display rank. Medical hierarchy lives on StaffProfile.
  rankId         String?
  rank           Rank?           @relation(fields: [rankId], references: [id], onDelete: SetNull)
  fivemCitizenId String?         @unique
  joinedAt       DateTime?       @db.Date
  roles          CharacterRole[]
  staffProfile StaffProfile?
  occupations    Occupation[]
  activeFor      Account?        @relation("ActiveCharacter")
  auditLogs      AuditLog[]      @relation("AuditActorCharacter")
  complaintsFiled       Complaint[]              @relation("ComplaintComplainant")
  complaintMessages     ComplaintMessage[]
  complaintInternalNotes ComplaintInternalNote[]
  complaintAssignments  ComplaintAssignment[]
  complaintEvents       ComplaintEvent[]
  appointmentsRequested       Appointment[]              @relation("AppointmentRequester")
  appointmentMessages         AppointmentMessage[]
  appointmentInternalNotes    AppointmentInternalNote[]
  appointmentAssignments      AppointmentAssignment[]
  appointmentEvents           AppointmentEvent[]
  notifications         Notification[]
  reportsCreated        Report[]                 @relation("ReportCreator")
  reportTransfers       ReportTransfer[]         @relation("ReportTransferActor")
  reportEvidenceUploads ReportEvidence[]         @relation("ReportEvidenceUploader")
  academyTrainingsInstructed AcademyTraining[]   @relation("AcademyTrainingInstructor")
  academyTrainingsCreated    AcademyTraining[]   @relation("AcademyTrainingCreator")
  academyAttendances         AcademyTrainingAttendance[]
  academyAnnouncementsAuthored AcademyAnnouncement[] @relation("AcademyAnnouncementAuthor")
  academyApplications        AcademyApplication[] @relation("AcademyApplicationApplicant")
  academyApplicationsReviewed AcademyApplication[] @relation("AcademyApplicationReviewer")
  newsArticlesAuthored       NewsArticle[]        @relation("NewsArticleAuthor")
  staffShifts                StaffShift[]
  /// Optional clinical Patient link (never required; Patient ≠ Character).
  linkedPatient              Patient?             @relation("PatientLinkedCharacter")
  patientsCreated            Patient[]            @relation("PatientCreatedBy")
  patientsUpdated            Patient[]            @relation("PatientUpdatedBy")
  patientInvoicesCreated     PatientInvoice[]     @relation("PatientInvoiceCreatedBy")
  institutionalPaymentsCreated InstitutionalPayment[] @relation("InstitutionalPaymentCreatedBy")
  institutionalPaymentsUpdated InstitutionalPayment[] @relation("InstitutionalPaymentUpdatedBy")
  institutionalPaymentsVoided  InstitutionalPayment[] @relation("InstitutionalPaymentVoidedBy")
  regulationDocumentsAuthored  RegulationDocument[] @relation("RegulationDocumentAuthor")
  regulationDocumentsEdited    RegulationDocument[] @relation("RegulationDocumentLastEditor")
  regulationVersionsCreated    RegulationDocumentVersion[] @relation("RegulationVersionCreatedBy")
  regulationAttachmentsUploaded RegulationAttachment[] @relation("RegulationAttachmentUploadedBy")
  incentivePaymentsMade      IncentivePayment[]   @relation("IncentivePaidBy")
  incentiveConfigurationsUpdated IncentiveConfiguration[] @relation("IncentiveConfigUpdatedBy")
  adminRequestsFiled         AdminRequest[]              @relation("AdminRequestRequester")
  adminRequestsAssigned      AdminRequest[]              @relation("AdminRequestAssignee")
  adminRequestMessages       AdminRequestMessage[]
  adminRequestInternalNotes  AdminRequestInternalNote[]
  adminRequestAssignments    AdminRequestAssignment[]
  adminRequestEvents         AdminRequestEvent[]
  agreementsCreated          Agreement[]        @relation("AgreementCreatedBy")
  agreementHistoriesChanged  AgreementHistory[] @relation("AgreementHistoryChangedBy")
  psychotechnicalEvaluationsAsPhysician PsychotechnicalEvaluation[] @relation("PsychotechnicalPhysician")
  psychotechnicalEvaluationsCreated     PsychotechnicalEvaluation[] @relation("PsychotechnicalCreatedBy")
  medicalLeavesAsPhysician   MedicalLeave[]     @relation("MedicalLeavePhysician")
  medicalLeavesCreated       MedicalLeave[]     @relation("MedicalLeaveCreatedBy")
  medicalRecordAccessRequestsFiled    MedicalRecordAccessRequest[] @relation("MedicalRecordAccessRequester")
  medicalRecordAccessRequestsReviewed MedicalRecordAccessRequest[] @relation("MedicalRecordAccessReviewer")
  medicalReportAccessGrantsReceived   MedicalReportAccessGrant[]   @relation("MedicalReportAccessRecipient")
  medicalReportAccessGrantsGranted    MedicalReportAccessGrant[]   @relation("MedicalReportAccessGrantedBy")
  medicalReportAccessGrantsRevoked    MedicalReportAccessGrant[]   @relation("MedicalReportAccessRevokedBy")
  medicalReportAccessViews            MedicalReportAccessViewLog[] @relation("MedicalReportAccessViewer")
  staffRatingsGiven                   StaffRating[]                @relation("StaffRatingReviewer")
  applicationConfigsOpened            ApplicationConfiguration[]   @relation("ApplicationConfigOpenedBy")
  applicationConfigsClosed            ApplicationConfiguration[]   @relation("ApplicationConfigClosedBy")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([accountId])
  @@index([rankId])
  @@index([status])
}

/// Civilian/agency employment. Independent from StaffProfile (SAED membership).
model Occupation {
  id              String          @id @default(uuid())
  characterId     String
  character       Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  type            OccupationType  @default(EMPLOYMENT)
  /// Display/snapshot name (kept for history even if Establishment is renamed).
  organization    String
  /// Optional FK to administrable Establishment catalog.
  establishmentId String?
  establishment   Establishment?  @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  position        String?
  isPrimary       Boolean         @default(false)
  isActive        Boolean         @default(true)
  startedAt       DateTime?       @db.Date
  endedAt         DateTime?       @db.Date
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([characterId])
  @@index([organization])
  @@index([establishmentId])
  @@index([isActive])
}

enum EstablishmentStatus {
  ACTIVE
  INACTIVE
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

/// Administrable civilian workplace / business catalog (replaces hardcoded selects).
model Establishment {
  id              String              @id @default(uuid())
  slug            String              @unique
  name            String              @unique
  description     String?
  logoUrl         String?
  status          EstablishmentStatus @default(ACTIVE)
  /// Shown as default Occupation.position when selected.
  defaultPosition String              @default("Empleado")
  occupationType  OccupationType      @default(BUSINESS)
  /// When false, hidden from character creation (e.g. archived brands).
  isSelectable    Boolean             @default(true)
  sortOrder       Int                 @default(0)
  occupations           Occupation[]
  agreements            Agreement[]
  patients              Patient[]
  institutionalPayments InstitutionalPayment[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status, isSelectable, sortOrder])
}

enum InstitutionalPaymentStatus {
  ACTIVE
  VOID
}

/// Independent institutional payment ledger (never mutates PatientInvoice rows).
/// Optional allocations reconcile a payment against one or more invoices.
model InstitutionalPayment {
  id                     String                      @id @default(uuid())
  establishmentId        String
  establishment          Establishment               @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  /// Snapshots so rename/archive of the establishment does not rewrite history.
  organizationName       String
  establishmentSlug      String
  amount                 Decimal                     @db.Decimal(12, 2)
  paymentDate            DateTime                    @db.Date
  periodStart            DateTime                    @db.Date
  periodEnd              DateTime                    @db.Date
  notes                  String?
  status                 InstitutionalPaymentStatus  @default(ACTIVE)
  voidedAt               DateTime?
  voidReason             String?
  voidedByCharacterId    String?
  voidedByCharacter      Character?                  @relation("InstitutionalPaymentVoidedBy", fields: [voidedByCharacterId], references: [id], onDelete: SetNull)
  createdByCharacterId   String?
  createdByCharacter     Character?                  @relation("InstitutionalPaymentCreatedBy", fields: [createdByCharacterId], references: [id], onDelete: SetNull)
  updatedByCharacterId   String?
  updatedByCharacter     Character?                  @relation("InstitutionalPaymentUpdatedBy", fields: [updatedByCharacterId], references: [id], onDelete: SetNull)
  allocations            InstitutionalPaymentAllocation[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([establishmentId, paymentDate])
  @@index([status, paymentDate])
  @@index([periodStart, periodEnd])
  @@index([createdByCharacterId])
}

/// Optional reconciliation of a payment against specific invoices (partial/multi allowed).
model InstitutionalPaymentAllocation {
  id        String               @id @default(uuid())
  paymentId String
  payment   InstitutionalPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   PatientInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal              @db.Decimal(12, 2)
  createdAt DateTime             @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

/// Institutional business agreement (convenio) with an Establishment. Independent entity.
model Agreement {
  id                   String           @id @default(uuid())
  establishmentId      String
  establishment        Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  status               AgreementStatus  @default(DRAFT)
  startsAt             DateTime         @db.Date
  endsAt               DateTime?        @db.Date
  discountPercent      Decimal          @db.Decimal(5, 2)
  notes                String?
  createdByCharacterId String?
  createdByCharacter   Character?       @relation("AgreementCreatedBy", fields: [createdByCharacterId], references: [id], onDelete: SetNull)
  history              AgreementHistory[]
  invoices             PatientInvoice[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([establishmentId, status])
  @@index([status, startsAt])
  @@index([endsAt])
}

/// Immutable change log for agreement terms (renewals, percentage changes).
model AgreementHistory {
  id                   String     @id @default(uuid())
  agreementId          String
  agreement            Agreement  @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  previousPercent      Decimal?   @db.Decimal(5, 2)
  newPercent           Decimal    @db.Decimal(5, 2)
  previousStatus       AgreementStatus?
  newStatus            AgreementStatus
  previousEndsAt       DateTime?  @db.Date
  newEndsAt            DateTime?  @db.Date
  notes                String?
  changedByCharacterId String?
  changedByCharacter   Character? @relation("AgreementHistoryChangedBy", fields: [changedByCharacterId], references: [id], onDelete: SetNull)
  createdAt            DateTime   @default(now())

  @@index([agreementId, createdAt])
}

/// Medical/civilian hierarchy catalog. Not authorization (RBAC uses Role).
model Rank {
  id          String           @id @default(uuid())
  name        String           @unique
  slug        String           @unique
  description String?
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  characters    Character[]
  staffProfiles StaffProfile[]
  openings      DepartmentOpening[]
  incentiveConfiguration IncentiveConfiguration?
  incentivePayments      IncentivePayment[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Department {
  id           String               @id @default(uuid())
  name         String               @unique
  slug         String               @unique
  description  String?
  imageUrl     String?
  isActive     Boolean              @default(true)
  staffProfiles StaffProfile[]
  memberships  StaffDepartment[]
  supervisors  DepartmentSupervisor[]
  openings     DepartmentOpening[]
  interestLetters InterestLetter[]
  reports      Report[]
  transfersFrom ReportTransfer[]    @relation("ReportTransferFrom")
  transfersTo   ReportTransfer[]    @relation("ReportTransferTo")
  appointments Appointment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

/// Many-to-many: a department may have multiple supervisors; a staff member may supervise several departments.
model DepartmentSupervisor {
  id               String         @id @default(uuid())
  departmentId       String
  department         Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  assignedAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())

  @@unique([departmentId, staffProfileId])
  @@index([staffProfileId])
}

model DepartmentOpening {
  id                   String                @id @default(uuid())
  departmentId           String
  department             Department              @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title                String
  description          String
  minRankId            String?
  minRank              Rank?                 @relation(fields: [minRankId], references: [id], onDelete: SetNull)
  status               DepartmentOpeningStatus @default(OPEN)
  createdByCharacterId String?
  openedAt             DateTime              @default(now())
  closedAt             DateTime?
  interestLetters      InterestLetter[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([departmentId, status])
  @@index([minRankId])
}

model InterestLetter {
  id                     String               @id @default(uuid())
  openingId              String
  opening                DepartmentOpening      @relation(fields: [openingId], references: [id], onDelete: Cascade)
  departmentId             String
  department               Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  staffProfileId       String
  staffProfile         StaffProfile       @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  motivation             String
  experience             String
  additionalInfo         String?
  status                 InterestLetterStatus @default(PENDING)
  reviewNotes            String?
  reviewedByCharacterId  String?
  reviewedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([openingId, staffProfileId])
  @@index([departmentId, status])
  @@index([staffProfileId])
}

/// Optional SAED membership for a character. Civilians have none.
/// `employeeNumber` identifies the staff member; `departmentId` is the denormalized primary department (synced from StaffDepartment.isPrimary).
model StaffProfile {
  id               String               @id @default(uuid())
  characterId      String               @unique
  character        Character            @relation(fields: [characterId], references: [id], onDelete: Cascade)
  employeeNumber      String               @unique
  rankId           String
  rank             Rank                 @relation(fields: [rankId], references: [id], onDelete: Restrict)
  departmentId       String?
  department         Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status           StaffStatus        @default(ACTIVE)
  callsign         String?
  joinedAt         DateTime             @default(now()) @db.Date
  decorations      StaffDecoration[]
  licenses         StaffLicense[]
  departmentMemberships StaffDepartment[]
  complaintsAgainst Complaint[]         @relation("ComplaintAccusedStaff")
  supervisedDepartments DepartmentSupervisor[]
  interestLetters  InterestLetter[]
  reportsLed       Report[]             @relation("ReportLead")
  reportParticipations ReportParticipant[]
  academyTrainingSupports AcademyTrainingSupportStaff[]
  staffShifts      StaffShift[]
  incentivePayments IncentivePayment[]
  ratings          StaffRating[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([rankId])
  @@index([departmentId])
  @@index([status])
}

/// Citizen feedback on medical staff after a completed administrative appointment.
/// Never deleted — ratings are immutable audit history belonging to the professional.
model StaffRating {
  id                  String       @id @default(uuid())
  ratingNumber        Int          @unique @default(autoincrement())
  staffProfileId      String
  staffProfile        StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  reviewerCharacterId String
  reviewerCharacter   Character    @relation("StaffRatingReviewer", fields: [reviewerCharacterId], references: [id], onDelete: Restrict)
  adminRequestId      String       @unique
  adminRequest        AdminRequest @relation(fields: [adminRequestId], references: [id], onDelete: Restrict)
  /// Star score from 1 to 5.
  score               Int
  comment             String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([staffProfileId, createdAt])
  @@index([reviewerCharacterId])
  @@index([score])
  @@index([createdAt])
}

/// Duty / shift clock-in records for medical staff.
model StaffShift {
  id               String       @id @default(uuid())
  staffProfileId   String
  staffProfile     StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  characterId      String
  character        Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  startedAt        DateTime
  endedAt          DateTime?
  durationSeconds  Int?
  status           ShiftStatus  @default(OPEN)
  timezone         String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([staffProfileId, status])
  @@index([staffProfileId, startedAt])
  @@index([characterId, startedAt])
}

/// Configurable incentive amount per institutional rank (never hardcode amounts in code).
model IncentiveConfiguration {
  id                   String     @id @default(uuid())
  rankId               String     @unique
  rank                 Rank       @relation(fields: [rankId], references: [id], onDelete: Cascade)
  amount               Decimal    @db.Decimal(12, 2)
  isActive             Boolean    @default(true)
  updatedByCharacterId String?
  updatedByCharacter   Character? @relation("IncentiveConfigUpdatedBy", fields: [updatedByCharacterId], references: [id], onDelete: SetNull)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([isActive])
}

/// Immutable incentive payment record. One payment every 7 days per staff member.
model IncentivePayment {
  id                String       @id @default(uuid())
  staffProfileId    String
  staffProfile      StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  paidByCharacterId String
  paidByCharacter   Character    @relation("IncentivePaidBy", fields: [paidByCharacterId], references: [id], onDelete: Restrict)
  amount            Decimal      @db.Decimal(12, 2)
  /// Rank used to resolve the amount at payment time (historical snapshot).
  rankId            String
  rank              Rank         @relation(fields: [rankId], references: [id], onDelete: Restrict)
  rankName          String
  rankSlug          String
  paidAt            DateTime     @default(now())
  /// Next eligibility instant after this payment (paidAt + cycle).
  nextEligibleAt    DateTime
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([staffProfileId, paidAt])
  @@index([paidByCharacterId, paidAt])
  @@index([rankId])
  @@index([paidAt])
  @@index([nextEligibleAt])
}

/// Many-to-many staff ↔ department with role (member / lead / supervisor).
model StaffDepartment {
  id               String                 @id @default(uuid())
  staffProfileId String
  staffProfile   StaffProfile         @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department               @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  role             DepartmentMembershipRole @default(MEMBER)
  isPrimary        Boolean                @default(false)
  isActive         Boolean                @default(true)
  assignedAt       DateTime               @default(now())
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([staffProfileId, departmentId])
  @@index([departmentId])
  @@index([staffProfileId, isActive])
}

model Decoration {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  imageUrl    String?
  isActive    Boolean             @default(true)
  staffDecorations StaffDecoration[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model StaffDecoration {
  id               String         @id @default(uuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  decorationId     String
  decoration       Decoration     @relation(fields: [decorationId], references: [id], onDelete: Cascade)
  awardedAt        DateTime       @default(now()) @db.Date
  notes            String?
  createdAt        DateTime       @default(now())

  @@unique([staffProfileId, decorationId])
  @@index([decorationId])
}

/// Catalog of special staff certifications (EMS, trauma, etc.).
model License {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String          @unique
  description String?
  imageUrl    String?
  isActive    Boolean         @default(true)
  staffLicenses StaffLicense[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model StaffLicense {
  id                  String         @id @default(uuid())
  staffProfileId    String
  staffProfile      StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  licenseId           String
  license             License        @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  assignedAt          DateTime       @default(now()) @db.Date
  assignedByAccountId String
  assignedByAccount   Account        @relation("LicenseAssignedBy", fields: [assignedByAccountId], references: [id], onDelete: Restrict)
  notes               String?
  createdAt           DateTime       @default(now())

  @@unique([staffProfileId, licenseId])
  @@index([licenseId])
  @@index([assignedByAccountId])
}

/// Clinical hospital record. Independent from Character (auth/RP identity).
/// Optional linkedCharacterId prepares future patient↔character linking.
model Patient {
  id                    String         @id @default(uuid())
  recordNumber          Int            @unique @default(autoincrement())
  firstName             String
  lastName              String
  middleName            String?
  birthDate             DateTime?      @db.Date
  sex                   CharacterSex?
  nationality           String?
  phone                 String?
  /// Optional RP identity document. Unique when present (PostgreSQL allows multiple nulls).
  identityDocument      String?        @unique
  bloodType             BloodType      @default(UNKNOWN)
  allergies             String?
  chronicConditions     String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  avatarUrl             String?
  status                PatientStatus  @default(ACTIVE)
  /// Workplace / organization belonging to this clinical record (independent of Character).
  establishmentId       String?
  establishment         Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  /// Institutional badge/placa — only meaningful for LSPD patients; cleared when leaving LSPD.
  badgeNumber           String?
  /// Optional link to a playable Character. Never required.
  linkedCharacterId     String?        @unique
  linkedCharacter       Character?     @relation("PatientLinkedCharacter", fields: [linkedCharacterId], references: [id], onDelete: SetNull)
  /// Normalized blob for fast flexible search (names + phone + document).
  searchKey             String
  createdByCharacterId  String?
  createdByCharacter    Character?     @relation("PatientCreatedBy", fields: [createdByCharacterId], references: [id], onDelete: SetNull)
  updatedByCharacterId  String?
  updatedByCharacter    Character?     @relation("PatientUpdatedBy", fields: [updatedByCharacterId], references: [id], onDelete: SetNull)
  invoices              PatientInvoice[]
  reports               Report[]
  medicalRecords        MedicalRecord[]
  hospitalizations      Hospitalization[]
  diagnoses             Diagnosis[]
  surgeries             Surgery[]
  psychotechnicalEvaluations PsychotechnicalEvaluation[]
  medicalLeaves         MedicalLeave[]
  medicalRecordAccessRequests MedicalRecordAccessRequest[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([searchKey])
  @@index([lastName, firstName])
  @@index([birthDate])
  @@index([phone])
  @@index([identityDocument])
  @@index([status])
  @@index([establishmentId])
  @@index([badgeNumber])
  @@index([createdAt])
}

enum PsychotechnicalResult {
  FIT
  FIT_WITH_OBSERVATIONS
  UNFIT
}

enum MedicalLeaveStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Independent psychotechnical evaluation (historial). Never a flat field on Patient.
model PsychotechnicalEvaluation {
  id                   String                @id @default(uuid())
  patientId            String
  patient              Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  result               PsychotechnicalResult
  issuedAt             DateTime              @db.Date
  expiresAt            DateTime?             @db.Date
  observations         String?
  physicianCharacterId String?
  physicianCharacter   Character?            @relation("PsychotechnicalPhysician", fields: [physicianCharacterId], references: [id], onDelete: SetNull)
  createdByCharacterId String?
  createdByCharacter   Character?            @relation("PsychotechnicalCreatedBy", fields: [createdByCharacterId], references: [id], onDelete: SetNull)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([patientId, issuedAt])
  @@index([result, expiresAt])
  @@index([physicianCharacterId])
}

/// Independent medical leave (baja médica) with immutable history.
model MedicalLeave {
  id                   String             @id @default(uuid())
  patientId            String
  patient              Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status               MedicalLeaveStatus @default(ACTIVE)
  startsAt             DateTime           @db.Date
  endsAt               DateTime?          @db.Date
  reason               String
  observations         String?
  physicianCharacterId String?
  physicianCharacter   Character?         @relation("MedicalLeavePhysician", fields: [physicianCharacterId], references: [id], onDelete: SetNull)
  createdByCharacterId String?
  createdByCharacter   Character?         @relation("MedicalLeaveCreatedBy", fields: [createdByCharacterId], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([patientId, status])
  @@index([status, startsAt])
  @@index([endsAt])
  @@index([physicianCharacterId])
}

enum MedicalRecordStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum HospitalizationStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
  CANCELLED
}

enum SurgeryStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// Clinical medical record (expediente). Always belongs to Patient, never Character.
model MedicalRecord {
  id                   String              @id @default(uuid())
  patientId            String
  patient              Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title                String
  summary              String?
  status               MedicalRecordStatus @default(OPEN)
  openedAt             DateTime            @default(now())
  closedAt             DateTime?
  createdByCharacterId String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([patientId, createdAt])
  @@index([status])
}

/// Hospital admission episode for a Patient.
model Hospitalization {
  id                   String                @id @default(uuid())
  patientId            String
  patient              Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  reason               String?
  notes                String?
  status               HospitalizationStatus @default(ADMITTED)
  admittedAt           DateTime              @default(now())
  dischargedAt         DateTime?
  createdByCharacterId String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([patientId, admittedAt])
  @@index([status])
}

/// Clinical diagnosis registered against a Patient.
model Diagnosis {
  id                   String    @id @default(uuid())
  patientId            String
  patient              Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  code                 String?
  name                 String
  notes                String?
  diagnosedAt          DateTime  @default(now()) @db.Date
  createdByCharacterId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([patientId, diagnosedAt])
}

/// Surgical procedure registered against a Patient.
model Surgery {
  id                   String        @id @default(uuid())
  patientId            String
  patient              Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name                 String
  notes                String?
  status               SurgeryStatus @default(SCHEDULED)
  performedAt          DateTime?     @db.Date
  createdByCharacterId String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([patientId, performedAt])
  @@index([status])
}

/// Catalog of billable clinical treatments (name + price for invoice selects).
model Treatment {
  id          String           @id @default(uuid())
  name        String           @unique
  price       Decimal          @db.Decimal(10, 2)
  description String?
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  invoices    PatientInvoice[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, sortOrder])
}

/// Invoice line tied to a Patient clinical record (never to Character).
model PatientInvoice {
  id                   String     @id @default(uuid())
  invoiceNumber        Int        @unique @default(autoincrement())
  patientId            String
  patient              Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatmentId          String
  treatment            Treatment  @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  /// Snapshot at billing time so catalog price changes do not rewrite history.
  treatmentName        String
  /// Pre-discount treatment price snapshot.
  originalAmount       Decimal    @db.Decimal(10, 2)
  discountPercent      Decimal    @default(0) @db.Decimal(5, 2)
  discountAmount       Decimal    @default(0) @db.Decimal(10, 2)
  /// Final amount charged (originalAmount - discountAmount).
  amount               Decimal    @db.Decimal(10, 2)
  /// Optional agreement used at billing time (historical reference).
  agreementId          String?
  agreement            Agreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  /// Convenio establishment display name (discount context).
  establishmentName    String?
  /// Institutional billing snapshot at emission time (never follows later job changes).
  billingOrganization      String?
  billingEstablishmentId   String?
  billingEstablishmentSlug String?
  issuedAt             DateTime   @db.Date
  notes                String?
  createdByCharacterId String?
  createdByCharacter   Character? @relation("PatientInvoiceCreatedBy", fields: [createdByCharacterId], references: [id], onDelete: SetNull)
  institutionalPaymentAllocations InstitutionalPaymentAllocation[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([patientId, issuedAt])
  @@index([treatmentId])
  @@index([agreementId])
  @@index([billingEstablishmentSlug, issuedAt])
  @@index([billingOrganization, issuedAt])
  @@index([createdByCharacterId])
}

enum MedicalRecordAccessStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

/// Temporary clinical-record access grant for external agencies (e.g. LSPD).
model MedicalRecordAccessRequest {
  id                     String                     @id @default(uuid())
  requestNumber          Int                        @unique @default(autoincrement())
  patientId              String
  patient                Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requesterCharacterId   String
  requesterCharacter     Character                  @relation("MedicalRecordAccessRequester", fields: [requesterCharacterId], references: [id], onDelete: Restrict)
  /// Snapshot of requester organization at request time.
  requesterOrganization  String
  reason                 String
  status                 MedicalRecordAccessStatus  @default(PENDING)
  reviewedByCharacterId  String?
  reviewedByCharacter    Character?                 @relation("MedicalRecordAccessReviewer", fields: [reviewedByCharacterId], references: [id], onDelete: SetNull)
  reviewedAt             DateTime?
  decisionNotes          String?
  approvedAt             DateTime?
  /// Access window end (typically approvedAt + 24h).
  expiresAt              DateTime?
  revokedAt              DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([patientId, status])
  @@index([requesterCharacterId, status])
  @@index([status, expiresAt])
  @@index([createdAt])
}

model Complaint {
  id                 String                   @id @default(uuid())
  caseNumber         Int                      @unique @default(autoincrement())
  title              String
  description        String
  incidentDate       DateTime?                @db.Date
  location           String?
  status             ComplaintStatus          @default(PENDING)
  complainantId      String
  complainant        Character                @relation("ComplaintComplainant", fields: [complainantId], references: [id], onDelete: Restrict)
  accusedStaffId   String?
  accusedStaff     StaffProfile?          @relation("ComplaintAccusedStaff", fields: [accusedStaffId], references: [id], onDelete: SetNull)
  evidence           ComplaintEvidence[]
  messages           ComplaintMessage[]
  internalNotes      ComplaintInternalNote[]
  assignments        ComplaintAssignment[]
  events             ComplaintEvent[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([complainantId])
  @@index([accusedStaffId])
  @@index([status])
  @@index([createdAt])
}

model ComplaintEvidence {
  id          String                @id @default(uuid())
  complaintId String
  complaint   Complaint             @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  type        ComplaintEvidenceType
  label       String?
  /// Image path (/uploads/...) or external video URL
  value       String
  createdAt   DateTime              @default(now())

  @@index([complaintId])
}

model ComplaintMessage {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorId    String
  author      Character @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body        String
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
  @@index([authorId])
}

model ComplaintInternalNote {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorId    String
  author      Character @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body        String
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
  @@index([authorId])
}

model ComplaintAssignment {
  id           String    @id @default(uuid())
  complaintId  String
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  characterId  String
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  isPrimary    Boolean   @default(false)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  @@unique([complaintId, characterId])
  @@index([characterId])
}

model ComplaintEvent {
  id          String             @id @default(uuid())
  complaintId String
  complaint   Complaint          @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       Character?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type        ComplaintEventType
  message     String
  metadata    Json?
  createdAt   DateTime           @default(now())

  @@index([complaintId, createdAt])
}

model Appointment {
  id             String            @id @default(uuid())
  caseNumber     Int               @unique @default(autoincrement())
  type           AppointmentType
  title          String
  description    String
  preferredDate  DateTime?         @db.Date
  status         AppointmentStatus @default(PENDING)
  requesterId    String
  requester      Character         @relation("AppointmentRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  departmentId   String?
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  scheduledAt    DateTime?
  messages       AppointmentMessage[]
  internalNotes  AppointmentInternalNote[]
  assignments    AppointmentAssignment[]
  events         AppointmentEvent[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([requesterId])
  @@index([departmentId])
  @@index([status])
  @@index([createdAt])
}

model AppointmentMessage {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  authorId      String
  author        Character   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body          String
  createdAt     DateTime    @default(now())

  @@index([appointmentId, createdAt])
  @@index([authorId])
}

model AppointmentInternalNote {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  authorId      String
  author        Character   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body          String
  createdAt     DateTime    @default(now())

  @@index([appointmentId, createdAt])
  @@index([authorId])
}

model AppointmentAssignment {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  characterId   String
  character     Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  isPrimary     Boolean     @default(false)
  assignedAt    DateTime    @default(now())
  unassignedAt  DateTime?

  @@unique([appointmentId, characterId])
  @@index([characterId])
}

model AppointmentEvent {
  id            String               @id @default(uuid())
  appointmentId String
  appointment   Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         Character?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type          AppointmentEventType
  message       String
  metadata      Json?
  createdAt     DateTime             @default(now())

  @@index([appointmentId, createdAt])
}

model Notification {
  id          String           @id @default(uuid())
  accountId   String
  account     Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  characterId String?
  character   Character?       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  href        String?
  metadata    Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([accountId, isRead, createdAt])
  @@index([characterId])
}

model AuditLog {
  id                String     @id @default(uuid())
  actorAccountId    String?
  actorAccount      Account?   @relation("AuditActorAccount", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorCharacterId  String?
  actorCharacter    Character? @relation("AuditActorCharacter", fields: [actorCharacterId], references: [id], onDelete: SetNull)
  /// Event key, e.g. staff.promote, staff.rank_changed
  action            String
  /// Entity class: Staff, Department, Complaint, Character, …
  targetType        String?
  /// Entity primary id (staffProfileId when targetType = Staff)
  targetId          String?
  metadata          Json?
  createdAt         DateTime   @default(now())

  @@index([actorAccountId])
  @@index([actorCharacterId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  slug        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  characters  CharacterRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@id([roleId, permissionId])
}

model CharacterRole {
  characterId String
  roleId      String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@id([characterId, roleId])
}

model Report {
  id                   String              @id @default(uuid())
  reportNumber         Int                 @unique @default(autoincrement())
  title                String
  type                 ReportType          @default(CONSULTATION)
  description          String
  incidentDate         DateTime?           @db.Date
  location             String?
  status               ReportStatus        @default(PENDING)
  priority             ReportPriority      @default(MEDIUM)
  /// Clinical subject. Every medical report must belong to a Patient (never Character).
  patientId            String
  patient              Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  departmentId           String?
  department             Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leadStaffId        String?
  leadStaff          StaffProfile?     @relation("ReportLead", fields: [leadStaffId], references: [id], onDelete: SetNull)
  createdByCharacterId String
  createdByCharacter   Character           @relation("ReportCreator", fields: [createdByCharacterId], references: [id], onDelete: Restrict)
  participants         ReportParticipant[]
  evidence             ReportEvidence[]
  transfers            ReportTransfer[]
  accessGrants         MedicalReportAccessGrant[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([patientId, createdAt])
  @@index([departmentId])
  @@index([leadStaffId])
  @@index([createdByCharacterId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model ReportParticipant {
  id               String         @id @default(uuid())
  reportId         String
  report           Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([reportId, staffProfileId])
  @@index([staffProfileId])
}

model ReportEvidence {
  id                     String             @id @default(uuid())
  reportId               String
  report                 Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type                   ReportEvidenceType
  /// Stored path (/uploads/...) or external URL — never Base64 payloads.
  value                  String
  label                  String?
  originalName           String?
  uploadedByCharacterId  String?
  uploadedByCharacter    Character?         @relation("ReportEvidenceUploader", fields: [uploadedByCharacterId], references: [id], onDelete: SetNull)
  createdAt              DateTime           @default(now())

  @@index([reportId])
  @@index([uploadedByCharacterId])
}

/// Immutable history of department responsibility transfers (derivaciones).
model ReportTransfer {
  id                       String    @id @default(uuid())
  reportId                 String
  report                   Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fromDepartmentId           String?
  fromDepartment             Department? @relation("ReportTransferFrom", fields: [fromDepartmentId], references: [id], onDelete: SetNull)
  toDepartmentId             String
  toDepartment               Department  @relation("ReportTransferTo", fields: [toDepartmentId], references: [id], onDelete: Restrict)
  transferredByCharacterId String
  transferredByCharacter   Character @relation("ReportTransferActor", fields: [transferredByCharacterId], references: [id], onDelete: Restrict)
  notes                    String?
  createdAt                DateTime  @default(now())

  @@index([reportId, createdAt])
  @@index([fromDepartmentId])
  @@index([toDepartmentId])
}

/// Scheduled academy training session.
model AcademyTraining {
  id                     String                  @id @default(uuid())
  title                  String
  description            String
  instructorCharacterId  String
  instructorCharacter    Character               @relation("AcademyTrainingInstructor", fields: [instructorCharacterId], references: [id], onDelete: Restrict)
  startsAt               DateTime
  location               String
  capacity               Int?
  status                 AcademyTrainingStatus   @default(SCHEDULED)
  createdByCharacterId   String
  createdByCharacter     Character               @relation("AcademyTrainingCreator", fields: [createdByCharacterId], references: [id], onDelete: Restrict)
  attendances            AcademyTrainingAttendance[]
  supportStaff        AcademyTrainingSupportStaff[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([startsAt])
  @@index([status])
  @@index([instructorCharacterId])
}

/// SAED staff assisting the primary instructor during a training.
model AcademyTrainingSupportStaff {
  id               String         @id @default(uuid())
  trainingId       String
  training         AcademyTraining @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([trainingId, staffProfileId])
  @@index([staffProfileId])
}

model AcademyTrainingAttendance {
  id          String                  @id @default(uuid())
  trainingId  String
  training    AcademyTraining         @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  characterId String
  character   Character               @relation(fields: [characterId], references: [id], onDelete: Cascade)
  status      AcademyAttendanceStatus @default(PENDING)
  respondedAt DateTime?
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([trainingId, characterId])
  @@index([characterId])
  @@index([status])
}

model AcademyAnnouncement {
  id                String                       @id @default(uuid())
  title             String
  content           String
  authorCharacterId String
  authorCharacter   Character                    @relation("AcademyAnnouncementAuthor", fields: [authorCharacterId], references: [id], onDelete: Restrict)
  priority          AcademyAnnouncementPriority  @default(NORMAL)
  publishedAt       DateTime                     @default(now())
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([publishedAt])
  @@index([priority])
}

/// Institutional landing news (CMS). Only PUBLISHED items appear on the public site.
model NewsArticle {
  id                    String     @id @default(uuid())
  title                 String
  summary               String
  content               String
  coverImageUrl         String?
  authorName            String
  authorCharacterId     String?
  authorCharacter       Character? @relation("NewsArticleAuthor", fields: [authorCharacterId], references: [id], onDelete: SetNull)
  status                NewsStatus @default(DRAFT)
  publishedAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([authorCharacterId])
}

/// Institutional landing gallery (bento). Only ACTIVE items appear on the public site.
model GalleryItem {
  id          String            @id @default(uuid())
  imageUrl    String
  title       String?
  description String?
  sortOrder   Int               @default(0)
  status      GalleryItemStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, sortOrder])
}

/// Shared application envelope for academy intake and transfer requests.
/// Typed form payloads live in `formData` (JSON) so each type can evolve independently.
model AcademyApplication {
  id                    String                   @id @default(uuid())
  type                  AcademyApplicationType
  status                AcademyApplicationStatus @default(PENDING)
  characterId           String
  character             Character                @relation("AcademyApplicationApplicant", fields: [characterId], references: [id], onDelete: Cascade)
  /// Discord username for SAED contact (not Discord snowflake ID).
  discordUsername       String?
  formData              Json
  internalNotes         String?
  reviewNotes           String?
  reviewedByCharacterId String?
  reviewedByCharacter   Character?               @relation("AcademyApplicationReviewer", fields: [reviewedByCharacterId], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([type, status])
  @@index([characterId, createdAt])
  @@index([status, createdAt])
}

/// Institutional administrative requests (meetings, agreements, commercial, etc.).
model AdminRequest {
  id           String               @id @default(uuid())
  requestNumber Int                 @unique @default(autoincrement())
  type         AdminRequestType
  status       AdminRequestStatus   @default(PENDING)
  priority     AdminRequestPriority @default(MEDIUM)
  subject      String
  reason       String
  requesterId  String
  requester    Character            @relation("AdminRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  /// Optional primary assignee (Alto Mando). Architecture ready for future workflows.
  assigneeId   String?
  assignee     Character?           @relation("AdminRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages     AdminRequestMessage[]
  internalNotes AdminRequestInternalNote[]
  assignments  AdminRequestAssignment[]
  events       AdminRequestEvent[]
  staffRating  StaffRating?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([requesterId])
  @@index([assigneeId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
}

/// Public chat thread for an administrative request. Text and/or image attachment.
model AdminRequestMessage {
  id             String       @id @default(uuid())
  adminRequestId String
  adminRequest   AdminRequest @relation(fields: [adminRequestId], references: [id], onDelete: Cascade)
  authorId       String
  author         Character    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body           String?
  /// Stored as /uploads/admin-request-chat/... when present.
  imageUrl       String?
  createdAt      DateTime     @default(now())

  @@index([adminRequestId, createdAt])
  @@index([authorId])
}

/// Staff-only notes. Never exposed to civilian requesters.
model AdminRequestInternalNote {
  id             String       @id @default(uuid())
  adminRequestId String
  adminRequest   AdminRequest @relation(fields: [adminRequestId], references: [id], onDelete: Cascade)
  authorId       String
  author         Character    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body           String
  createdAt      DateTime     @default(now())

  @@index([adminRequestId, createdAt])
  @@index([authorId])
}

/// Assignment history / multi-assignee support (primary also mirrored on AdminRequest.assigneeId).
model AdminRequestAssignment {
  id             String       @id @default(uuid())
  adminRequestId String
  adminRequest   AdminRequest @relation(fields: [adminRequestId], references: [id], onDelete: Cascade)
  characterId    String
  character      Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  isPrimary      Boolean      @default(true)
  assignedAt     DateTime     @default(now())
  unassignedAt   DateTime?

  @@unique([adminRequestId, characterId])
  @@index([characterId])
}

model AdminRequestEvent {
  id             String                @id @default(uuid())
  adminRequestId String
  adminRequest   AdminRequest          @relation(fields: [adminRequestId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          Character?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type           AdminRequestEventType
  message        String
  metadata       Json?
  createdAt      DateTime              @default(now())

  @@index([adminRequestId, createdAt])
}

/// Institutional documentation library (regulations, protocols, manuals).
enum RegulationDocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model RegulationCategory {
  id          String               @id @default(uuid())
  name        String               @unique
  slug        String               @unique
  description String?
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)
  documents   RegulationDocument[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([isActive, sortOrder])
}

model RegulationDocument {
  id                   String                   @id @default(uuid())
  categoryId           String
  category             RegulationCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title                String
  slug                 String                   @unique
  summary              String?
  /// Current HTML body (sanitized on write).
  contentHtml          String                   @db.Text
  /// Plain-text extract for search.
  contentText          String                   @db.Text
  status               RegulationDocumentStatus @default(DRAFT)
  versionNumber        Int                      @default(1)
  authorCharacterId    String?
  authorCharacter      Character?               @relation("RegulationDocumentAuthor", fields: [authorCharacterId], references: [id], onDelete: SetNull)
  lastEditorCharacterId String?
  lastEditorCharacter  Character?               @relation("RegulationDocumentLastEditor", fields: [lastEditorCharacterId], references: [id], onDelete: SetNull)
  publishedAt          DateTime?
  versions             RegulationDocumentVersion[]
  attachments          RegulationAttachment[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([categoryId, status])
  @@index([status, updatedAt])
  @@index([title])
  @@index([authorCharacterId])
}

/// Immutable snapshot created on each meaningful content change.
model RegulationDocumentVersion {
  id                   String                   @id @default(uuid())
  documentId           String
  document             RegulationDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber        Int
  title                String
  summary              String?
  contentHtml          String                   @db.Text
  contentText          String                   @db.Text
  status               RegulationDocumentStatus
  changeSummary        String?
  createdByCharacterId String?
  createdByCharacter   Character?               @relation("RegulationVersionCreatedBy", fields: [createdByCharacterId], references: [id], onDelete: SetNull)
  createdAt            DateTime                 @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
}

model RegulationAttachment {
  id                   String             @id @default(uuid())
  documentId           String
  document             RegulationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName             String
  fileUrl              String
  mimeType             String
  sizeBytes            Int
  sortOrder            Int                @default(0)
  uploadedByCharacterId String?
  uploadedByCharacter  Character?         @relation("RegulationAttachmentUploadedBy", fields: [uploadedByCharacterId], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())

  @@index([documentId, sortOrder])
}

/// Temporary SAED → external agency access to a specific medical report.
enum MedicalReportAccessGrantStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

/// Extensible reason catalog for medical report interop grants.
enum MedicalReportAccessReason {
  CRIMINAL_INVESTIGATION
  FORENSIC_CASE
  COURT_ORDER
  INTERNAL_INVESTIGATION
  PROSECUTOR_REQUEST
  OTHER
}

model MedicalReportAccessGrant {
  id                    String                         @id @default(uuid())
  grantNumber           Int                            @unique @default(autoincrement())
  reportId              String
  report                Report                         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  recipientCharacterId  String
  recipientCharacter    Character                      @relation("MedicalReportAccessRecipient", fields: [recipientCharacterId], references: [id], onDelete: Restrict)
  grantedByCharacterId  String
  grantedByCharacter    Character                      @relation("MedicalReportAccessGrantedBy", fields: [grantedByCharacterId], references: [id], onDelete: Restrict)
  organization          String                         @default("LSPD")
  reason                MedicalReportAccessReason
  reasonNotes           String?
  status                MedicalReportAccessGrantStatus @default(ACTIVE)
  grantedAt             DateTime                       @default(now())
  expiresAt             DateTime
  revokedAt             DateTime?
  revokedByCharacterId  String?
  revokedByCharacter    Character?                     @relation("MedicalReportAccessRevokedBy", fields: [revokedByCharacterId], references: [id], onDelete: SetNull)
  viewCount             Int                            @default(0)
  lastViewedAt          DateTime?
  viewLogs              MedicalReportAccessViewLog[]
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@index([reportId, status])
  @@index([recipientCharacterId, status, expiresAt])
  @@index([grantedByCharacterId])
  @@index([status, expiresAt])
  @@index([organization, createdAt])
}

model MedicalReportAccessViewLog {
  id                String                   @id @default(uuid())
  grantId           String
  grant             MedicalReportAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  viewerCharacterId String
  viewerCharacter   Character                @relation("MedicalReportAccessViewer", fields: [viewerCharacterId], references: [id], onDelete: Restrict)
  viewedAt          DateTime                 @default(now())

  @@index([grantId, viewedAt])
  @@index([viewerCharacterId, viewedAt])
}
