# SAED Web - copy to web/.env and adjust values
# On Railway these must be set BEFORE build (Vite embeds them at build time).

# Local
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000

# Production example (replace with your public API URL):
# VITE_API_BASE_URL=https://<api-service>.up.railway.app/api/v1
# VITE_SOCKET_URL=https://<api-service>.up.railway.app

# true  -> JWT + API identity (recommended)
# false -> legacy localStorage session fallback
VITE_USE_API_AUTH=true
