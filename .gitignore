.env
.env.*
!.env.example
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime uploads & temp
uploads/
.upload-tmp/
temp/
tmp/
.tmp/
.cache/
*.dump
tmp-supabase-migration.dump
api/tmp-supabase-migration.dump

# IDE / editor
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo

# Cursor (local agent / IDE state)
.cursor/

# OS
.DS_Store
Thumbs.db
Desktop.ini

