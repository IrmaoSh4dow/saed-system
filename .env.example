# =============================================================================
# SAED Management System - Environment reference
# =============================================================================
# Copy the API block into api/.env and the Web block into web/.env
# Never commit real secrets. See README.md and docs/RAILWAY.md.
# =============================================================================

# --- Shared ---
NODE_ENV=development

# --- API (api/.env) ---
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173

# PostgreSQL (matches database/docker-compose.yml defaults)
DATABASE_URL=postgresql://saed:saed@localhost:5432/saed?schema=public

# JWT (use a long random secret in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional: Discord webhook for duty clock events (never expose to frontend)
DISCORD_SHIFTS_WEBHOOK_URL=

# Optional: public origin used when building absolute asset URLs
PUBLIC_ASSET_BASE_URL=http://localhost:5173

# Uploads are stored under api/uploads/ (ignored by git; created at runtime)

# --- Web (web/.env) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000
VITE_USE_API_AUTH=true

# --- Railway (set in dashboard, never commit) ---
# API: NODE_ENV, PORT (injected), FRONTEND_URL, DATABASE_URL, JWT_SECRET, API_PREFIX
# Optional API: DISCORD_SHIFTS_WEBHOOK_URL, PUBLIC_ASSET_BASE_URL
# Web (build-time): VITE_API_BASE_URL, VITE_SOCKET_URL, VITE_USE_API_AUTH
# See docs/RAILWAY.md
